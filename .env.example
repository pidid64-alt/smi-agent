# Скопируйте в .env и заполните. Файл .env НЕ должен попадать в Git (он в .gitignore).
# Секреты храните в менеджере секретов (Docker/Kubernetes secrets, Vault, KMS) — здесь только перечень переменных.

# --- окружение ---------------------------------------------------------------------------
SMI_ENV=production                      # dev | test | production (production включает строгие проверки)
SMI_PUBLIC_URL=https://smi.example.kz   # внешний адрес (https обязателен в production): cookie Secure, проверка Origin, ссылки на медиа
SMI_TRUST_PROXY=0                       # 1 — брать IP клиента из X-Forwarded-For (ТОЛЬКО за доверенным прокси, который перезаписывает заголовок)
SMI_EMBEDDED_WORKER=1                   # 1 — фоновые задания внутри процесса API (для одного узла); иначе запускайте `smi-agent worker` отдельно

# --- хранилище ---------------------------------------------------------------------------
SMI_DATABASE_URL=sqlite:////data/smi_agent.db
# PostgreSQL (не проверялось в среде разработки, см. docs/OPERATIONS.md):
# SMI_DATABASE_URL=postgresql+psycopg://smi:CHANGE_ME@postgres:5432/smi
SMI_DATA_DIR=/data
SMI_BACKUP_DIR=/backups
SMI_BACKUP_INTERVAL_MIN=15              # RPO = этот интервал
SMI_BACKUP_RETENTION=96

# --- ключи (генерация: smi-agent keys generate) -------------------------------------------
SMI_MASTER_KEYS=                        # kid:base64url(32 байта)[,старый_kid:...] — первый ключ текущий; в production обязателен
SMI_BACKUP_KEY=                         # base64url(32 байта), отдельный от мастер-ключа; в production обязателен

# --- безопасность ------------------------------------------------------------------------
SMI_REQUIRE_MFA_FOR_ADMIN=              # пусто = true в production; false — только для разработки
SMI_LOGIN_MAX_FAILURES=5
SMI_LOGIN_LOCK_MINUTES=15
SMI_SESSION_IDLE_MINUTES=720
SMI_SESSION_ABSOLUTE_HOURS=168
SMI_ENABLE_DOCS=                        # пусто = выкл. в production; 1 — открыть /docs (Swagger)
SMI_ALLOW_PRIVATE_FETCH=0               # НЕ включать в production: разрешает обращения к внутренним адресам (SSRF-защита)
SMI_RESPECT_ROBOTS=1

# --- LLM (необязательно; без неё тексты — заготовки для редактора, автопилот не публикует) --
SMI_LLM_PROVIDER=none                   # none | openai_compat | anthropic
SMI_LLM_BASE_URL=https://api.openai.com/v1
SMI_LLM_API_KEY=
SMI_LLM_MODEL=
SMI_LLM_DAILY_CALL_BUDGET=2000

# --- платформы ---------------------------------------------------------------------------
SMI_META_GRAPH_VERSION=v26.0            # версия Graph API; в Meta действует график депрекаций — проверяйте
SMI_META_APP_ID=                        # для OAuth Meta (необязательно; можно подключать по токену)
SMI_META_APP_SECRET=
# Токены Telegram/Instagram/Facebook вводятся в интерфейсе (Управление → Аккаунты) и хранятся шифрованными в БД.
# Пароли внешних платформ не запрашиваются и не хранятся.

# --- демо (только разработка!) ------------------------------------------------------------
# SMI_DEMO_MODE=1                        # вымышленные новости, песочница вместо платформ; в production запрещено
# SMI_DEMO_PASSWORD=                     # пароль демо-пользователей (по умолчанию smi-agent-showcase)
